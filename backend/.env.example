# Copy this file to .env and fill in real values. Never commit .env.
PORT=5000
NODE_ENV=development

# Must match where the Vite frontend runs (cookies + CORS need an exact origin, not *)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL connection string (create the database first, e.g. "cropshield")
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cropshield?schema=public

# Secret used to sign login tokens. Must be long and random (32+ characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Password given to the demo Expert/Officer/Admin/Farmer accounts created by `npm run seed` (development only).
SEED_DEMO_PASSWORD=

# --- Image storage (Phase D) ---
# Fill ALL THREE to store crop photos on Cloudinary. Leave them empty to use the LOCAL development fallback
# (photos are saved in backend/uploads/ and served by this server; not allowed when NODE_ENV=production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only used by the local fallback: the address the browser uses to reach this server.
PUBLIC_URL=http://localhost:5000

# --- AI prediction (Phase E) ---
# Leave AI_SERVICE_URL empty to run in MOCK mode (simulated results, clearly labelled as mock in the API).
# Set it to the FastAPI service address to use the real AI service, e.g. http://localhost:8000
AI_MODE=
AI_SERVICE_URL=
AI_SERVICE_API_KEY=
AI_TIMEOUT_MS=20000
